rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Check if user is authenticated with Firebase
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if authenticated user is an authorized member of the requested store
    function isStoreMember(storeId) {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid))
      );
    }

    // Secure PIN Registry (store_pins): Maps hashed PIN to permanent storeId
    match /store_pins/{pinHash} {
      // Allow get only by exact hash lookup; prevent collection listing / enumeration
      allow get: if isAuthenticated();
      allow list: if false;

      // Allow creating a new PIN mapping if authenticated and user is owner
      allow create: if isAuthenticated() && 
        request.resource.data.storeId is string &&
        request.resource.data.ownerUid == request.auth.uid;

      // Allow update or delete if user is the owner or an authorized store member
      allow update, delete: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid ||
        isStoreMember(resource.data.storeId)
      );
    }

    // Public store registry reference (resolves storeId for customer portal links)
    match /public/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Isolated Store Partition (/stores/{storeId}/...)
    match /stores/{storeId} {
      // Root store document access
      allow read: if true;
      allow create: if isAuthenticated() && 
        request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isStoreMember(storeId) || (isAuthenticated() && resource.data.ownerUid == request.auth.uid);

      // Members subcollection:
      // Membership creation or update is allowed if:
      // 1. An existing authorized store member is modifying the member
      // OR
      // 2. The user is enrolling/connecting themselves (request.auth.uid == memberId) AND provides
      //    a valid pinHash matching this storeId in /store_pins/{pinHash}.
      match /members/{memberId} {
        allow read: if isStoreMember(storeId) || (isAuthenticated() && request.auth.uid == memberId);
        
        allow create, update: if isAuthenticated() && (
          isStoreMember(storeId) ||
          (
            request.auth.uid == memberId &&
            request.resource.data.pinHash is string &&
            get(/databases/$(database)/documents/store_pins/$(request.resource.data.pinHash)).data.storeId == storeId
          )
        );

        allow delete: if isStoreMember(storeId);
      }

      // Metadata subcollection (Store Info, Pre-order Open/Close status, Add-ons)
      // Publicly readable so customer menu knows store name, WhatsApp number, add-ons, and open/closed state
      // Writable only by authenticated store members or owner during provisioning
      match /meta/{docId} {
        allow read: if true;
        allow write: if isStoreMember(storeId) || (isAuthenticated() && resource == null);
      }

      // Products subcollection: Publicly readable for customer pre-order menu, editable only by store staff/owner
      match /products/{productId} {
        allow read: if true;
        allow write: if isStoreMember(storeId);
      }

      // Pending Orders subcollection:
      // Public customers may create a customer pre-order with strict document validation.
      // Customers CANNOT read other customers' pending orders, nor update/delete.
      // Store members have full management access.
      match /pendingOrders/{pendingId} {
        allow create: if isStoreMember(storeId) || (
          // Public customer pre-order creation validation:
          // 1. Must be a brand-new document (cannot overwrite existing pending orders)
          resource == null &&
          // 2. ID matches document path
          request.resource.data.orderId == pendingId &&
          request.resource.data.orderId is string &&
          // 3. Targeted store matches path
          (!('storeId' in request.resource.data) || request.resource.data.storeId == storeId) &&
          // 4. Required fields and structure
          request.resource.data.date is string &&
          request.resource.data.time is string &&
          request.resource.data.totalAmount is number &&
          request.resource.data.totalAmount >= 0 &&
          request.resource.data.items is list &&
          request.resource.data.items.size() > 0 &&
          // 5. Source identifies customer pre-order
          (request.resource.data.orderSource == 'customer_preorder' || 
           (request.resource.data.source is string && request.resource.data.source.matches('(?i).*customer.*'))) &&
          // 6. Customer cannot submit already approved/completed order
          request.resource.data.status == 'pending' &&
          // 7. Customer cannot set inventoryDeducted to true
          request.resource.data.inventoryDeducted == false
        );
        allow read, update, delete: if isStoreMember(storeId);
      }

      // Devices subcollection
      match /devices/{deviceId} {
        allow read, write: if isStoreMember(storeId);
      }

      // Inventory subcollection:
      // Publicly readable so customer menu can verify item availability / in-stock status.
      // Writable ONLY by authorized store members.
      match /inventory/{itemId} {
        allow read: if true;
        allow write: if isStoreMember(storeId);
      }

      // Inventory Movements subcollection:
      // Writable and readable ONLY by authorized store members.
      match /inventoryMovements/{movementId} {
        allow read, write: if isStoreMember(storeId);
      }

      // Transactional & Private Subcollections:
      // /stores/{storeId}/orders/{orderId}
      // /stores/{storeId}/expenses/{expenseId}
      // /stores/{storeId}/shifts/{shiftId}
      // /stores/{storeId}/distributions/{month}
      match /{subcollection}/{docId} {
        allow read, write: if isStoreMember(storeId);
      }
    }

    // Authenticated User Profile records
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}



